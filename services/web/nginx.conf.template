server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Only ${API_UPSTREAM} is substituted at container start; all $nginx vars
    # below are preserved (entrypoint runs envsubst with an explicit var list).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # Generated per-deploy; never cache it.
    location = /config.js {
        try_files $uri =404;
        add_header Cache-Control "no-store";
    }

    # Clean routes: /scholarship -> scholarship.html, etc.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
