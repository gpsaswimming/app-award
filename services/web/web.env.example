# app-award-web — runtime config (DMZ node). Copy to `.env`. NO SECRETS here.
# The service loads it via `env_file: [.env]`. See docs/DESIGN.md §7.

# Internal address of app-award-api (scheme://host:port, NO trailing slash)
API_UPSTREAM=http://app-award-api:3000

# Cloudflare Turnstile PUBLIC site key (safe to expose in the page)
TURNSTILE_SITE_KEY=

# Shown on the landing page and forms
SEASON=2026
HURDLE_DEADLINE=2026-07-26T23:59:59-04:00
LAMBERSON_DEADLINE=2026-07-26T23:59:59-04:00
