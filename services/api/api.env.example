# app-award-api — runtime config (app node).
# Copy to `.env` next to the compose file, fill in, chmod 600. NEVER commit the real file.
# The service loads it via `env_file: [.env]`. See docs/DESIGN.md §7.

# Cloudflare Turnstile (bot gate) — server secret
TURNSTILE_SECRET_KEY=

# SMTP (GPSA mail server) — use a dedicated, scoped account
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=awards@gpsaswimming.org

# Recipients
PRESIDENT_EMAIL=
NOTIFY_EMAIL=

# Season + deadlines (ISO 8601 WITH a timezone offset)
SEASON=2026
HURDLE_DEADLINE=2026-07-27T23:59:59-04:00
LAMBERSON_DEADLINE=2026-07-27T23:59:59-04:00

# Optional — override the season essay prompts (defaults live in code)
# HURDLE_PROMPT=
# LAMBERSON_PROMPT=

# Optional — league timezone used for submission IDs (default America/New_York)
# TZ_LEAGUE=America/New_York

# Container port
PORT=3000
